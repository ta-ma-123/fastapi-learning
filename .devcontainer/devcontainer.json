{
  "name": "FastAPI Learning",
  "dockerComposeFile": "../compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "runServices": [
    "db",
    "test-db"
  ],
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "forwardPorts": [
    8000
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  }
}
